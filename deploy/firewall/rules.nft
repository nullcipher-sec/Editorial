flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        ip protocol icmp accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        ip saddr 10.20.20.0/24 ip daddr 10.20.30.0/24 tcp dport 8080 accept
        ip saddr 10.20.30.0/24 ip daddr 10.20.40.10 tcp dport 5432 accept
        ip saddr 10.20.50.0/24 ip daddr 10.20.40.10 tcp dport 5432 accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
