# Valores de DESARROLLO LOCAL listos para usar con deploy/docker-compose.dev.yml.
# Uso:  cp .env.dev.example .env
# Solo para pruebas en tu máquina: NO reutilizar en producción (ahí usar .env.example y secretos propios).
# Si cambias LDAP_ADMIN_PASSWORD, actualiza también el healthcheck de ldap en docker-compose.dev.yml.

# PostgreSQL
POSTGRES_USER=editorial
POSTGRES_PASSWORD=editorial_dev_only
POSTGRES_DB=editorial

# Core
CORE_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# LDAP (OpenLDAP de desarrollo; usuarios de prueba en deploy/ldap/bootstrap.ldif)
LDAP_ADMIN_PASSWORD=admin_dev_only
LDAP_DOMAIN=editorial.local
LDAP_MANAGER_DN=cn=admin,dc=editorial,dc=local
LDAP_MANAGER_PASSWORD=admin_dev_only

# JWT (mín. 32 caracteres)
JWT_ISSUER=editorial-core
EDITORIAL_JWT_SECRET=local-dev-only-secret-32-chars-min!!
EDITORIAL_JWT_EXPIRATION_HOURS=8
EDITORIAL_LDAP_ENABLED=true
